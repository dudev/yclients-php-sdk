{
    "name": "dudev/yclients-php-sdk",
    "description": "PHP SDK for the YClients REST API (https://developers.yclients.com/ru/)",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "dudev"
        }
    ],
    "require": {
        "php": "^8.2",
        "psr/log": "^3.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "php-http/discovery": "^1.19"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "php-http/mock-client": "^1.6",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Dudev\\YclientsPhpSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dudev\\YclientsPhpSdk\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
